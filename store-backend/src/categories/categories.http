# @import ../auth/http/verify-otp.http

@baseUrl = http://localhost:8080

### ─── CREATE ─────────────────────────────────────
# @ref login
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{login.accessToken}}
{
  "name": "فشارسنج دیجیتال سخنگو",
  "slug": "digital-talking-blood-pressure",
  "parentId": 1,
  "sortOrder": 2,
  "description": "فشارسنج‌های هوشمند و دیجیتالی سخنگو با قابلیت اعلام صوتی نتایج و حافظه ذخیره‌سازی",
  "metaTitle": "خرید فشارسنج دیجیتال سخنگو اصل | آریامدیک",
  "metaDescription": "لیست قیمت و خرید جدیدترین مدل‌های فشارسنج دیجیتال سخنگو با ضمانت اصالت کالا",
  "isActive": true
}

### ─── LIST ALL ────────────────────────────────────
# @ref login
GET {{baseUrl}}/categories
Authorization: Bearer {{login.accessToken}}

### ─── FIND BY ID ─────────────────────────────────
# @ref login
GET {{baseUrl}}/categories/1
Authorization: Bearer {{login.accessToken}}

### ─── FIND BY SLUG ───────────────────────────────
# @ref login
GET {{baseUrl}}/categories/by-slug/general-medical-equipment
Authorization: Bearer {{login.accessToken}}

### ─── SUBTREE ─────────────────────────────────────
# @ref login
GET {{baseUrl}}/categories/1/subtree
Authorization: Bearer {{login.accessToken}}

### ─── BREADCRUMBS ────────────────────────────────
# @ref login
GET {{baseUrl}}/categories/1/breadcrumbs
Authorization: Bearer {{login.accessToken}}

### ─── UPDATE ─────────────────────────────────────
# @ref login
PATCH {{baseUrl}}/categories/3
Content-Type: application/json
Authorization: Bearer {{login.accessToken}}

{
  "name": "فشارسنج دیجیتال بازو"
}

### ─── DELETE ─────────────────────────────────────
# @ref login
DELETE {{baseUrl}}/categories/7
Authorization: Bearer {{login.accessToken}}

### ─── REBUILD PATHS (Admin) ──────────────────────
# @ref login
POST {{baseUrl}}/categories/admin/rebuild-paths
Authorization: Bearer {{login.accessToken}}
