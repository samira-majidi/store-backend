# @import ../../auth/http/verify-otp.http

@baseUrl = http://localhost:8080
# آیدی محصول و واریانت رو بعد از ساخت محصول اینجا قرار بده تا بقیه ریکوئست‌ها راحت کار کنن
@productId =045662bf-8900-4846-915f-56f4f02deca8
@variantId =65b36ebf-3bc3-43c2-88fb-e1415c1c20a1
@categorySlug = digital-arm-blood-pressure
### 1. ایجاد محصول جدید با تنوع‌ها (Variants)
# @ref login
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: GAPGPTMASKTOKENsepadg1yawgX0X {{login.accessToken}}
{
  "title": "دستگاه اکسیژن‌ساز ۵ لیتری امرن",
  "brand": "Omron",
  "slug": "omron-oxygen-concentrator-5l",
  "categoryId": 8, 
  "imageIds": [14], 
  "shortDescription": "اکسیژن‌ساز بی‌صدا و قدرتمند مناسب استفاده ۲۴ ساعته.",
  "isSpecial": true,
  "features": ["ظرفیت: ۵ لیتر در دقیقه", "خلوص اکسیژن: بالای ۹۳ درصد"],
  "variants": [
    {
      "sku": "OMR-OXY-STD",
      "model": "استاندارد",
      "price": 28000000,
      "stock": 3,
      "isDefault": true
    },
    {
      "sku": "OMR-OXY-PRO",
      "model": "پرو (همراه با سنسور پالس اکسی‌متر)",
      "price": 31000000,
      "stock": 1,
      "isDefault": false
    }
  ]
}
### 2. ویرایش محصول و همگام‌سازی تنوع‌ها و گالری
# @ref login
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: GAPGPTMASKTOKENsepadg1yawgX1X {{login.accessToken}}


{
  "imageIds": [9,6]
}

### 3. افزودن تکی یک واریانت به محصول
# @ref login
POST {{baseUrl}}/products/{{productId}}/variants
Content-Type: application/json
Authorization: GAPGPTMASKTOKENsepadg1yawgX2X {{login.accessToken}}

{
  "sku": "OM-M3-BLU",
  "color": "آبی",
  "price": 2950000,
  "discountPercentage": 0,
  "stock": 8,
  "isDefault": false
}


### تنظیم تخفیف شگفت‌انگیز برای یک واریانت (Flash Sale)
# @ref login
PATCH {{baseUrl}}/products/{{productId}}/variants/{{variantId}}/discount
Content-Type: application/json
Authorization: GAPGPTMASKTOKENsepadg1yawgX3X {{login.accessToken}}

{
  "discountPercentage": 0
 
}

### 4. حذف یک واریانت تکی از محصول
# @ref login
DELETE {{baseUrl}}/products/{{productId}}/variants/{{variantId}}
Content-Type: application/json
Authorization: GAPGPTMASKTOKENsepadg1yawgX3X {{login.accessToken}}

### 5. حذف کامل محصول
# @ref login
DELETE {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: GAPGPTMASKTOKENsepadg1yawgX4X {{login.accessToken}}
  


### دریافت محصولات یک دسته‌بندی
GET {{baseUrl}}/public/products/category/digital-arm-blood-pressure?page=1&limit=20
Content-Type: application/json

### دریافت محصولات پیشنهاد ویژه
GET {{baseUrl}}/public/products/special?limit=10
Content-Type: application/json

### دریافت جزئیات یک محصول با شناسه
GET {{baseUrl}}/public/products/{{productId}}
Content-Type: application/json


### ==================== فیلتر محصولات ====================

### ۱. جستجوی زنده (Instant Search)
GET {{baseUrl}}/public/products/search?keyword=فشارسنج
Content-Type: application/json

### ۲. دریافت گزینه‌های فیلتر (کل محصولات - بدون دسته‌بندی)
GET {{baseUrl}}/public/products/filter-options
Content-Type: application/json

### ۳. دریافت گزینه‌های فیلتر برای یک دسته‌بندی خاص (با ID)
GET {{baseUrl}}/public/products/filter-options?categoryId=8
Content-Type: application/json

### ۴. دریافت گزینه‌های فیلتر برای یک دسته‌بندی خاص (با Slug)
GET {{baseUrl}}/public/products/filter-options?categorySlug={{categorySlug}}
Content-Type: application/json

### ۵. فیلتر محصولات: فقط بر اساس بازه قیمت
GET {{baseUrl}}/public/products/category/{{categorySlug}}?minPrice=1000000&maxPrice=5000000
Content-Type: application/json

### ۶. فیلتر محصولات: فقط بر اساس برند
# نکته: اگر `brands` در DTO به صورت آرایه است، ممکن است نیاز باشد در URL به فرمت &brands=Omron&brands=Beurer ارسال شود یا اگر با کاما جدا می‌شود به شکل زیر:
GET {{baseUrl}}/public/products/category/{{categorySlug}}?brands=Beurer
Content-Type: application/json

### ۷. فیلتر ترکیبی کامل: کلمه کلیدی + برند + بازه قیمت + دسته‌بندی
GET {{baseUrl}}/public/products/category/{{categorySlug}}?brands=Microlife&minPrice=1000000&maxPrice=50000000
Content-Type: application/json